# Copy to .env for local dev (pnpm --filter api run dev picks it up automatically).
# Without this, /transcription-token returns 501 and the web app falls back
# to the Web Speech API (see web/src/speech/elevenLabsSource.ts and
# web/src/present/liveEngine.ts) -- so this is optional for local dev.

# P4-1: get a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

{
  "name": "@flowio/api",
  "private": true,
  "version": "0.0.1",
  "description": "Deck API (P1-6 hello world): Lambda handlers behind API Gateway, backed by DynamoDB.",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/localServer.ts",

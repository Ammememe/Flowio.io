{
  "name": "@flowio/api",
  "private": true,
  "version": "0.0.1",
  "description": "Deck API: Lambda handlers behind API Gateway, backed by DynamoDB and Cognito auth (P3-1/P3-2/P3-8).",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/localServer.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "@aws-sdk/s3-presigned-post": "^3.1169.0",
    "@flowio/shared": "workspace:*",
    "aws-jwt-verify": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

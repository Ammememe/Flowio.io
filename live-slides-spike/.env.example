# Only needed for the provider comparison (P0-8). Copy to .env and fill in.
# Keys stay on your machine: the local proxy reads them, the browser never sees them.

# Deepgram: create a key at https://console.deepgram.com
DEEPGRAM_API_KEY=
# Model to request. If Swedish is rejected on this model, try nova-2.
DEEPGRAM_MODEL=nova-3

# Amazon Transcribe: uses your normal AWS credentials (environment, ~/.aws profile or SSO).
# The identity needs the transcribe:StartStreamTranscription permission.
# AWS_PROFILE=
# Region for Transcribe streaming. Check that streaming is offered in the region you pick.
TRANSCRIBE_REGION=eu-west-1

# STT_PROXY_PORT=8787

{
  "name": "@flowio/mcp",
  "private": true,
  "version": "0.0.1",
  "description": "MCP server for Claude (Phase 5): lets a Claude chat create and edit decks that open in the app.",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1169.0",
    "@flowio/api": "workspace:*",
    "@flowio/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
